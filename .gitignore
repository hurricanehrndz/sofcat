# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib
*.msi

# Include phony packages for running tests
!pkg/installer/testdata/packages/*/*
!pkg/status/testdata/*

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Project-local glide cache, RE: https://github.com/Masterminds/glide/issues/736
.glide/

# OS files
*.DS_Store

# Misc files used in dev
config.json
config.yaml

# Credential safety net (not build output): never commit certs or private keys
*.pfx
*.cer

# WIX files
*.wixpdb
*.wixobj

# Local build artifacts
build/

# Machine-local agent instructions (test rig details); see AGENTS.md
AGENTS.local.md

# Machine-local agent/test-rig helpers (rig orchestrators); see AGENTS.local.md
.claude/

# mise per-machine overrides
mise.local.toml
