# A SofCat brand. Copy this directory to branding/<name>/ (gitignored) and
# build with `just brand=branding/<name> build` or `msi`. Every key is
# optional and falls back to stock SofCat, but SLUG, NAME and IDENTIFIER must
# all change together: the service, pipe, ProgramData folder, policy key and
# MSI upgrade code derive from them. Values are sourced by bash.

# Service name, pipe prefix (<slug>-service), exe names (<slug>.exe and
# <slug>-ui.exe) and %LocalAppData% folder. 2-32 of a-z, 0-9 and -.
SLUG=acme-apps
# Display name: Start menu, Add/Remove Programs, window title, VERSIONINFO,
# C:\Program Files\<NAME>, C:\ProgramData\<NAME> and the branding policy key
# HKLM\SOFTWARE\Policies\<NAME>\Branding.
NAME="Acme Software Center"
# Reverse-DNS; seeds the MSI upgrade code, so keep it stable across releases.
IDENTIFIER=com.example.softwarecenter
PUBLISHER="Acme Corp"
DESCRIPTION="Install and update Acme-approved software"
HOMEPAGE=https://help.example.com/software
