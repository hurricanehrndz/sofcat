# Stock product name; `just brand=…` overrides it from the environment.
VITE_PRODUCT_NAME=SofCat
# The loading screen's mark, a file in public/; a brand loading.gif overrides it.
VITE_LOADING_ICON=sofcat-icon.png
# The loading screen's line; a brand's LOADING_TEXT overrides it.
VITE_LOADING_TEXT=Connecting to the SofCat service…
# The splash: "true" keeps the loading screen up on every launch for at least
# VITE_LOADING_SECONDS; a brand's LOADING_ALWAYS and LOADING_SECONDS override them.
VITE_LOADING_ALWAYS=false
VITE_LOADING_SECONDS=3
