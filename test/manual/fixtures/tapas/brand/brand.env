# The Tapas Test fixture brand: `just bootstrap-tapas` builds it, and
# test/manual/run-tapas-smoke.ps1 checks it on a Windows VM (run-tapas-smoke.sh
# on a Mac, after `just bootstrap-tapas-macos`). Its names differ
# from stock SofCat, so it installs beside a stock build. See
# examples/brand/brand.env for what each key sets. No icons: the stock ones
# apply.
SLUG=tapas-test
NAME="Tapas Test"
IDENTIFIER=ca.hrndz.tapas-test
PUBLISHER="Carlos Hernandez"
DESCRIPTION="Fixture brand for the Tapas zip-item smoke test"
HOMEPAGE=https://github.com/hurricanehrndz/sofcat
# Zip-only: no command installers or catalog scripts in either binary.
INSTALLERS=zip
