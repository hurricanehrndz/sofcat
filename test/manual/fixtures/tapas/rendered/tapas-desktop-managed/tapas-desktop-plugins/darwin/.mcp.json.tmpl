{
  "mcpServers": {
    "tapas-chatproxy": {
      "type": "http",
      "url": "https://chatproxy.tapas.example/mcp",
      "headers": {
        "x-litellm-api-key": "Bearer {{ fact "assigned_user" }}/claudecode",
        "x-tapas-platform": {{ if cond "os == \"windows\"" }}"windows"{{ else }}"macos"{{ end }}
      }
    }
  }
}
