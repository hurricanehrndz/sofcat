# On Linux with nix, load flake.nix for the GTK/WebKit libraries the UI links
# against. Other distros install them from their package manager; macOS
# needs none.
if has nix && [[ "$(uname -s)" == Linux ]]; then
  use flake
fi

# Load the mise toolchain (mise.toml) when entering the repo with direnv.
watch_file mise.toml mise.local.toml
direnv_load mise direnv exec
